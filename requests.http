### 1. GET all items
GET http://localhost:8080/items

### 2. GET one item
GET http://localhost:8080/items/1

### 3. GET an item that does not exist (expect 404)
GET http://localhost:8080/items/99

### 4. POST a new item (expect 201)
POST http://localhost:8080/items
Content-Type: application/json

{
  "type": "Electronics",
  "id": 11,
  "name": "Laptop",
  "description": "Grey, stickers",
  "foundBy": "Lee",
  "brand": "Dell",
  "serialNumber": "DL-99",
  "building": "MC Building",
  "room": "MC101"
}

### 5. POST the same id again (expect 400)
POST http://localhost:8080/items
Content-Type: application/json

{
  "type": "Electronics",
  "id": 11,
  "name": "Laptop"
}

### 6. PUT a new description (expect 200)
PUT http://localhost:8080/items/11
Content-Type: application/json

{
  "description": "Grey, one sticker"
}

### 7. DELETE the item (expect 200)
DELETE http://localhost:8080/items/11

### 8. DELETE it again (expect 404)
DELETE http://localhost:8080/items/11

### 9. GET all claims
GET http://localhost:8080/claims

### 10. POST a claim for item 1 (expect 201)
POST http://localhost:8080/claims
Content-Type: application/json

{
  "itemId": 1,
  "personId": 1,
  "name": "Sam Okoro",
  "email": "sam@wlv.ac.uk",
  "phone": "07700 900123"
}

### 11. Claim item 1 again (expect 400, already claimed)
POST http://localhost:8080/claims
Content-Type: application/json

{
  "itemId": 1,
  "personId": 1,
  "name": "Sam Okoro",
  "email": "sam@wlv.ac.uk"
}
